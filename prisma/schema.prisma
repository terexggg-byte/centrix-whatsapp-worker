  createdBy           User                     @relation("ProductReservationCreator", fields: [createdById], references: [id])
  deliveredBy         User?                    @relation("ProductReservationDeliverer", fields: [deliveredById], references: [id], onDelete: Restrict)
  product             Product                  @relation(fields: [productId], references: [id])
  deliveredSale       ProductSale?             @relation("ReservationDeliveredSale", fields: [saleId], references: [id], onDelete: Restrict)
  student             Student?                 @relation(fields: [studentId], references: [id])
  center              Center                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, productId, status, createdAt])
  @@index([tenantId, studentId, createdAt])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  tenantId        String
  productId       String
  type            InventoryMovementType
  quantity        Int
  balanceAfter    Int
  reservedAfter   Int
