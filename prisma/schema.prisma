generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformAdmin {
  id                    String    @id @default(cuid())
  fullName              String
  email                 String    @unique
  password              String
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  appearancePreferences Json?
}

model PlatformStaff {
  id                    String                       @id @default(cuid())
  fullName              String
  email                 String                       @unique
  password              String
  role                  PlatformStaffRole
  isActive              Boolean                      @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  grantedPermissions    PlatformStaffPermission[]    @default([])
  jobTitle              String?
  phone                 String?
  revokedPermissions    PlatformStaffPermission[]    @default([])
  sessionVersion        Int                          @default(1)
  baseSalary            Float                        @default(0)
  salaryCurrency        String                       @default("EGP")
  salaryDueDay          Int                          @default(1)
  appearancePreferences Json?
  activityLogs          PlatformStaffActivityLog[]
  payrollRecords        PlatformStaffPayrollRecord[]

  @@index([role, isActive])
}

model PlatformStaffActivityLog {
  id         String                      @id @default(cuid())
  staffId    String?
  staffEmail String?
  actorType  PlatformStaffActorType
  actorId    String?
  actorEmail String?
  event      PlatformStaffActivityEvent
  status     PlatformStaffActivityStatus @default(SUCCESS)
  message    String?
  payload    Json?
  createdAt  DateTime                    @default(now())
  staff      PlatformStaff?              @relation(fields: [staffId], references: [id])

  @@index([staffId, createdAt])
  @@index([staffEmail, createdAt])
  @@index([event, status, createdAt])
}

model PlatformStaffPayrollRecord {
  id                 String                     @id @default(cuid())
  staffId            String
  monthKey           String
  baseSalarySnapshot Float
  bonusAmount        Float                      @default(0)
  deductionAmount    Float                      @default(0)
  netAmount          Float
  status             PlatformStaffPayrollStatus @default(UNPAID)
  paidAt             DateTime?
  note               String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  staff              PlatformStaff              @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, monthKey])
  @@index([monthKey])
  @@index([status, monthKey])
}

model Center {
  id                             String                          @id @default(cuid())
  code                           String                          @unique
  name                           String
  ownerName                      String
  ownerEmail                     String
  phone                          String
  status                         CenterAccountStatus             @default(TRIAL)
  subscriptionStart              DateTime?
  subscriptionEnd                DateTime?
  maxBranches                    Int                             @default(1)
  maxUsers                       Int                             @default(3)
  maxStudents                    Int?
  logoUrl                        String?
  primaryColor                   String?
  secondaryColor                 String?
  contactNumbers                 String[]
  settings                       Json?
  isArchived                     Boolean                         @default(false)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  archiveReason                  String?
  archivedAt                     DateTime?
  archivedBy                     String?
  statusBeforeArchive            CenterAccountStatus?
  maxClassrooms                  Int?
  cardPointBalance               Int                             @default(0)
  cardPointPriceOverride         Float?
  announcements                  Announcement[]
  assistantConversations         AssistantConversation[]
  assistantMessages              AssistantMessage[]
  attendance                     AttendanceRecord[]
  makeupAttendances              MakeupAttendance[]
  auditLogs                      AuditLog[]
  billingRecords                 BillingRecord[]
  branches                       Branch[]
  cardPointTransactions          CardPointTransaction[]
  centerAccessCode               CenterAccessCode?
  brandKit                       CenterBrandKit?
  centerStaffPayrollRecords      CenterStaffPayrollRecord[]
  subscriptions                  CenterSubscription[]
  certificateGenerationSnapshots CertificateGenerationSnapshot[]
  certificateNumberCounters      CertificateNumberCounter[]
  classrooms                     Classroom[]
  exams                          Exam[]
  examResults                    ExamResult[]
  expenses                       Expense[]
  monthlyPrices                  GradeMonthlySubscriptionPrice[]
  groups                         Group[]
  groupSchedules                 GroupSchedule[]
  homeworkRequirements           HomeworkRequirement[]
  homeworkSubmissions            HomeworkSubmission[]
  inventoryDocumentCounters      InventoryDocumentCounter[]
  inventoryMovements             InventoryMovement[]
  inventoryStocks                InventoryStock[]
  notificationChannelSettings    NotificationChannelSetting[]
  notificationDeliveries         NotificationDelivery[]
  notificationEventSettings      NotificationEventSetting[]
  notificationJobs               NotificationJob[]
  notificationTemplates          NotificationTemplate[]
  payments                       Payment[]
  products                       Product[]
  productCategories              ProductCategory[]
  productImageAssets             ProductImageAsset[]
  productReservations            ProductReservation[]
  productSales                   ProductSale[]
  productSalePayments            ProductSalePayment[]
  productUnits                   ProductUnit[]
  purchaseOrders                 PurchaseOrder[]
  scheduleSuspensions            ScheduleSuspension[]
  sessions                       Session[]
  students                       Student[]
  studentBillingPauses           StudentBillingPause[]
  studentBookingCounters         StudentBookingNumberCounter[]
  studentBookings                StudentBookingRequest[]
  studentCardCustomTemplates     StudentCardCustomTemplate[]
  studentCardExportJobs          StudentCardExportJob[]
  studentPerformanceReportSends  StudentPerformanceReportSend[]
  studentProductAccounts         StudentProductAccount[]
  studentProductAccountEntries   StudentProductAccountEntry[]
  studentSubs                    StudentSubscription[]
  studentPlans                   SubscriptionPlan[]
  suppliers                      Supplier[]
  teachers                       Teacher[]
  users                          User[]
  whatsappAuthStates             WhatsAppAuthState[]
  whatsappSession                WhatsAppSession?

  @@index([status])
  @@index([subscriptionEnd])
  @@index([isArchived])
  @@index([isArchived, createdAt])
  @@index([archivedAt])
  @@index([cardPointBalance])
}

model StudentCardCustomTemplate {
  id                   String                          @id @default(cuid())
  centerId             String
  name                 String
  status               StudentCardCustomTemplateStatus @default(DRAFT)
  sourceFileName       String
  sourceContentType    String
  sourceFileSize       Int
  sourceChecksum       String
  originalObjectKey    String
  renderObjectKey      String
  thumbnailObjectKey   String?
  documentVersion      Int                             @default(2)
  document             Json
  editorSettings       Json
  aiAnalysis           Json?
  recoveryMetadata     Json?
  namedVersionManifest Json?
  createdBy            String
  updatedBy            String
  activatedAt          DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  studioMetadata       Json?
  center               Center                          @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, status, updatedAt])
  @@index([centerId, createdAt])
}

model StudentCardExportJob {
  id                  String                     @id @default(cuid())
  tenantId            String
  requestedById       String
  status              StudentCardExportJobStatus @default(QUEUED)
  request             Json
  settings            Json
  templateFingerprint Json
  side                String
  totalCards          Int
  totalPages          Int
  totalParts          Int
  completedParts      Int                        @default(0)
  completedPages      Int                        @default(0)
  phase               String                     @default("QUEUED")
  processedUnits      Int                        @default(0)
  totalUnits          Int                        @default(0)
  processedPages      Int                        @default(0)
  activeProcessingMs  Int                        @default(0)
  currentPartNumber   Int?
  progressUpdatedAt   DateTime?
  metrics             Json?
  attempts            Int                        @default(0)
  maxAttempts         Int                        @default(3)
  availableAt         DateTime                   @default(now())
  lockedAt            DateTime?
  lockToken           String?
  lockedBy            String?
  startedAt           DateTime?
  completedAt         DateTime?
  expiresAt           DateTime?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  center              Center                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parts               StudentCardExportPart[]

  @@index([tenantId, status, createdAt])
  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([expiresAt])
}

model StudentCardExportPart {
  id            String                     @id @default(cuid())
  jobId         String
  partNumber    Int
  status        StudentCardExportJobStatus @default(QUEUED)
  studentIds    Json
  pageStart     Int
  pageEnd       Int
  pageCount     Int
  phase         String                     @default("QUEUED")
  processedUnits Int                       @default(0)
  totalUnits    Int                        @default(0)
  processedPages Int                       @default(0)
  activeProcessingMs Int                   @default(0)
  progressUpdatedAt DateTime?
  metrics       Json?
  attempts      Int                        @default(0)
  maxAttempts   Int                        @default(3)
  blobObjectKey String?
  fileName      String?
  asciiFileName String?
  contentLength Int?
  checksum      String?
  startedAt     DateTime?
  completedAt   DateTime?
  expiresAt     DateTime?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  job           StudentCardExportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, partNumber])
  @@index([jobId, status, partNumber])
  @@index([status, updatedAt])
  @@index([expiresAt])
}

model CenterBrandKit {
  id                     String   @id @default(cuid())
  centerId               String   @unique
  version                Int      @default(1)
  revision               Int      @default(1)
  definition             Json
  primaryLogoObjectKey   String?
  secondaryLogoObjectKey String?
  createdBy              String
  updatedBy              String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  center                 Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, updatedAt])
}

model Plan {
  id              String               @id @default(cuid())
  name            String               @unique
  price           Float
  duration        PlanDuration
  features        Json?
  maxStudents     Int?
  maxUsers        Int
  maxBranches     Int
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  durationDays    Int?
  isDeleted       Boolean              @default(false)
  maxClassrooms   Int?
  discountedPrice Float?
  isRecommended   Boolean              @default(false)
  sortOrder       Int                  @default(0)
  subscriptions   CenterSubscription[]

  @@index([isActive])
  @@index([isDeleted])
  @@index([sortOrder])
}

model CenterSubscription {
  id                  String                     @id @default(cuid())
  centerId            String
  planId              String
  startDate           DateTime
  endDate             DateTime
  status              PlatformSubscriptionStatus @default(TRIAL)
  autoSuspendOnExpiry Boolean                    @default(true)
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  queueOrder          Int                        @default(0)
  billingRecords      BillingRecord[]
  center              Center                     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  plan                Plan                       @relation(fields: [planId], references: [id])

  @@index([centerId, status])
  @@index([centerId, queueOrder])
  @@index([endDate])
}

model BillingRecord {
  id             String              @id @default(cuid())
  centerId       String
  subscriptionId String?
  amount         Float
  currency       String              @default("EGP")
  dueDate        DateTime
  paidAt         DateTime?
  status         BillingStatus       @default(UNPAID)
  invoiceNo      String
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  invoiceType    String              @default("GENERAL")
  entryType      BillingEntryType    @default(REVENUE)
  source         BillingEntrySource  @default(MANUAL)
  center         Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subscription   CenterSubscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([centerId, invoiceNo])
  @@index([centerId, status, dueDate])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                            String                         @id @default(cuid())
  tenantId                      String
  fullName                      String
  email                         String
  password                      String
  role                          Role
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  baseSalary                    Float                          @default(0)
  isActive                      Boolean                        @default(true)
  jobTitle                      String?
  phone                         String?
  salaryCurrency                String                         @default("EGP")
  salaryDueDay                  Int                            @default(1)
  accessCodeHash                String?
  accessCodeUpdatedAt           DateTime?
  grantedPermissions            CenterPermission[]             @default([])
  revokedPermissions            CenterPermission[]             @default([])
  staffType                     CenterStaffType?
  appearancePreferences         Json?
  assistantConversations        AssistantConversation[]
  assistantMessages             AssistantMessage[]
  auditLogs                     AuditLog[]
  makeupAttendancesCancelled    MakeupAttendance[]             @relation("MakeupCancelledBy")
  makeupAttendancesCreated      MakeupAttendance[]             @relation("MakeupCreatedBy")
  payrollRecords                CenterStaffPayrollRecord[]     @relation("CenterStaffPayrollStaff")
  expensesCreated               Expense[]                      @relation("ExpenseCreator")
  inventoryMovementsCreated     InventoryMovement[]            @relation("InventoryMovementActor")
  payments                      Payment[]                      @relation("PaymentReceiver")
  productImageAssetsUploaded    ProductImageAsset[]            @relation("ProductImageAssetUploader")
  productReservationsCancelled  ProductReservation[]           @relation("ProductReservationCanceller")
  productReservationsCreated    ProductReservation[]           @relation("ProductReservationCreator")
  productReservationsDelivered  ProductReservation[]           @relation("ProductReservationDeliverer")
  productSalesCancelled         ProductSale[]                  @relation("ProductSaleCanceller")
  productSalesCompleted         ProductSale[]                  @relation("ProductSaleSeller")
  productSalePaymentsReceived   ProductSalePayment[]           @relation("ProductSalePaymentReceiver")
  purchaseOrdersCreated         PurchaseOrder[]                @relation("PurchaseOrderCreator")
  reviewedStudentBookings       StudentBookingRequest[]        @relation("StudentBookingReviewer")
  studentPerformanceReportSends StudentPerformanceReportSend[] @relation("StudentPerformanceReportSender")
  productAccountEntriesCreated  StudentProductAccountEntry[]   @relation("StudentProductAccountEntryActor")
  center                        Center                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, role])
}

model Branch {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  address    String
  center     Center      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classrooms Classroom[]
  groups     Group[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Classroom {
  id              String                  @id @default(cuid())
  tenantId        String
  branchId        String
  name            String
  capacity        Int
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  center          Center                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups          Group[]
  sessions        Session[]
  students        Student[]
  studentBookings StudentBookingRequest[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
}

model Teacher {
  id          String    @id @default(cuid())
  tenantId    String
  fullName    String
  phone       String
  subjects    String[]
  payoutMode  String
  payoutValue Float
  groups      Group[]
  sessions    Session[]
  center      Center    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Student {
  id                     String                         @id @default(cuid())
  tenantId               String
  code                   String
  fullName               String
  phone                  String
  parentPhone            String
  grade                  String
  school                 String?
  subjects               String[]
  joinedAt               DateTime                       @default(now())
  status                 StudentStatus                  @default(ACTIVE)
  notes                  String?
  avatarUrl              String?
  groupId                String?
  classroomId            String?
  firstCyclePrice        Float?
  firstCyclePriceUsedAt  DateTime?
  monthlyDiscountAmount  Float                          @default(0)
  monthlyPriceOverride   Float?
  monthlyPricingMode     StudentMonthlyPricingMode      @default(DEFAULT)
  attendance             AttendanceRecord[]
  makeupAttendances      MakeupAttendance[]
  cardPointTransactions  CardPointTransaction[]
  examResults            ExamResult[]
  payments               Payment[]
  productReservations    ProductReservation[]
  productSales           ProductSale[]
  classroom              Classroom?                     @relation(fields: [classroomId], references: [id])
  group                  Group?                         @relation(fields: [groupId], references: [id])
  center                 Center                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingPauses          StudentBillingPause[]
  bookingRequests        StudentBookingRequest[]
  performanceReportSends StudentPerformanceReportSend[]
  productAccount         StudentProductAccount?
  productAccountEntries  StudentProductAccountEntry[]
  subscriptions          StudentSubscription[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, joinedAt])
  @@index([tenantId, grade, joinedAt])
  @@index([tenantId, groupId])
  @@index([tenantId, groupId, joinedAt])
  @@index([tenantId, classroomId])
  @@index([tenantId, classroomId, joinedAt])
  @@index([tenantId, status])
}

model CardPointTransaction {
  id           String                   @id @default(cuid())
  centerId     String
  studentId    String?
  type         CardPointTransactionType
  points       Int
  balanceAfter Int
  unitPrice    Float                    @default(0)
  totalAmount  Float                    @default(0)
  actorId      String?
  actorScope   String?
  note         String?
  createdAt    DateTime                 @default(now())
  center       Center                   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student      Student?                 @relation(fields: [studentId], references: [id])

  @@index([centerId, createdAt])
  @@index([centerId, type, createdAt])
  @@index([studentId, createdAt])
}

model StudentBookingRequest {
  id                String               @id @default(cuid())
  tenantId          String
  bookingNumber     String
  studentId         String?
  fullName          String
  phone             String
  parentPhone       String
  grade             String
  groupId           String?
  classroomId       String?
  scheduleId        String?
  scheduleDays      String[]
  scheduleStartTime String
  scheduleEndTime   String
  status            StudentBookingStatus @default(PENDING)
  rejectionReason   String?
  submittedAt       DateTime             @default(now())
  approvedAt        DateTime?
  rejectedAt        DateTime?
  reviewedByUserId  String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  classroom         Classroom?           @relation(fields: [classroomId], references: [id])
  group             Group?               @relation(fields: [groupId], references: [id])
  reviewedBy        User?                @relation("StudentBookingReviewer", fields: [reviewedByUserId], references: [id])
  schedule          GroupSchedule?       @relation(fields: [scheduleId], references: [id])
  student           Student?             @relation(fields: [studentId], references: [id])
  center            Center               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, groupId])
  @@index([tenantId, studentId])
  @@index([tenantId, reviewedByUserId])
}

model StudentBookingNumberCounter {
  id           String   @id @default(cuid())
  tenantId     String
  year         Int
  nextSequence Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  center       Center   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year])
  @@index([tenantId])
}

model StudentPerformanceReportSend {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  month        String
  sentAt       DateTime @default(now())
  sentByUserId String?
  parentPhone  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sentByUser   User?    @relation("StudentPerformanceReportSender", fields: [sentByUserId], references: [id])
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  center       Center   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, month])
  @@index([tenantId, month])
  @@index([tenantId, sentByUserId])
}

model StudentBillingPause {
  id        String                    @id @default(cuid())
  tenantId  String
  studentId String
  reason    StudentBillingPauseReason
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  student   Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  center    Center                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, startsAt])
  @@index([tenantId, startsAt])
  @@index([tenantId, studentId, endsAt])
}

model ScheduleSuspension {
  id                        String                    @id @default(cuid())
  tenantId                  String
  scope                     ScheduleSuspensionScope
  branchId                  String?
  grade                     String?
  groupId                   String?
  classroomId               String?
  canonicalScopeKey         String
  scopeLabel                String
  reason                    String?
  startsAt                  DateTime
  plannedEndsAt             DateTime
  effectiveEndsAt           DateTime
  notificationRecipientMode NotificationRecipientMode @default(PARENT_ONLY)
  revision                  Int                       @default(1)
  canceledAt                DateTime?
  endedEarlyAt              DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  occurrenceDateKey         String?
  sourceScheduleId          String?
  center                    Center                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, canonicalScopeKey, startsAt, effectiveEndsAt])
  @@index([tenantId, startsAt, effectiveEndsAt])
  @@index([tenantId, scope, branchId])
  @@index([tenantId, groupId, classroomId])
  @@index([tenantId, scope, sourceScheduleId, occurrenceDateKey], map: "ScheduleSuspension_occurrence_lookup_idx")
}

model Group {
  id              String                  @id @default(cuid())
  tenantId        String
  name            String
  subject         String
  grade           String?
  teacherId       String
  branchId        String?
  classroomId     String?
  capacity        Int
  days            String[]
  startTime       String
  endTime         String
  status          GroupStatus             @default(ACTIVE)
  exams           Exam[]
  branch          Branch?                 @relation(fields: [branchId], references: [id])
  classroom       Classroom?              @relation(fields: [classroomId], references: [id])
  teacher         Teacher                 @relation(fields: [teacherId], references: [id])
  center          Center                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupSchedules  GroupSchedule[]
  originalMakeupAttendances    MakeupAttendance[] @relation("MakeupOriginalGroup")
  replacementMakeupAttendances MakeupAttendance[] @relation("MakeupReplacementGroup")
  sessions        Session[]
  students        Student[]
  studentBookings StudentBookingRequest[]

  @@index([tenantId, name])
  @@unique([tenantId, id])
}

model GroupSchedule {
  id                   String                  @id @default(cuid())
  tenantId             String
  groupId              String
  classroomId          String
  days                 String[]
  startTime            String
  endTime              String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  grade                String?
  group                Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  center               Center                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeworkRequirements HomeworkRequirement[]
  sessions             Session[]              @relation("SessionSourceSchedule")
  originalMakeupAttendances    MakeupAttendance[] @relation("MakeupOriginalSchedule")
  replacementMakeupAttendances MakeupAttendance[] @relation("MakeupReplacementSchedule")
  studentBookings      StudentBookingRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, groupId])
  @@index([tenantId, classroomId])
}

model HomeworkRequirement {
  id          String                   @id @default(cuid())
  tenantId    String
  scheduleId  String
  day         String
  scope       HomeworkRequirementScope @default(WEEKLY)
  dateKey     String                   @default("")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  archivedAt  DateTime?
  description String?
  title       String?
  schedule    GroupSchedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  center      Center                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([tenantId, scheduleId, day, scope, dateKey])
  @@index([tenantId, scope, dateKey])
  @@index([tenantId, scheduleId])
  @@index([tenantId, archivedAt])
}

model Session {
  id              String             @id @default(cuid())
  tenantId        String
  groupId         String
  teacherId       String
  classroomId     String
  startsAt        DateTime
  durationMinutes Int
  status          SessionStatus      @default(POSTPONED)
  sourceScheduleId String?
  occurrenceDateKey String?
  attendance      AttendanceRecord[]
  originalMakeupAttendances    MakeupAttendance[] @relation("MakeupOriginalSession")
  replacementMakeupAttendances MakeupAttendance[] @relation("MakeupReplacementSession")
  classroom       Classroom          @relation(fields: [classroomId], references: [id])
  group           Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sourceSchedule  GroupSchedule?     @relation("SessionSourceSchedule", fields: [sourceScheduleId], references: [id], onDelete: SetNull)
  teacher         Teacher            @relation(fields: [teacherId], references: [id])
  center          Center             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sourceScheduleId, occurrenceDateKey])
  @@index([tenantId, startsAt])
  @@index([tenantId, groupId, startsAt])
}

model AttendanceRecord {
  id                 String              @id @default(cuid())
  tenantId           String
  studentId          String
  sessionId          String
  status             AttendanceStatus
  note               String?
  makeupAttendanceId String?             @unique
  session            Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  center             Center              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  makeupAttendance   MakeupAttendance?   @relation("MakeupReplacementAttendance", fields: [tenantId, makeupAttendanceId], references: [tenantId, id], onDelete: Restrict)
  originalForMakeup  MakeupAttendance[]  @relation("MakeupOriginalAttendance")
  homeworkSubmission HomeworkSubmission?

  @@unique([studentId, sessionId])
  @@unique([tenantId, id])
  @@unique([tenantId, makeupAttendanceId])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, status])
}

model MakeupAttendance {
  id                           String                 @id @default(cuid())
  tenantId                     String
  studentId                    String
  type                         MakeupAttendanceType   @default(PREVIOUS_ABSENCE)
  originalAttendanceId         String?
  originalSessionId            String
  originalScheduleId           String?
  originalOccurrenceDateKey    String?
  originalGroupId              String
  replacementScheduleId        String?
  replacementOccurrenceDateKey String
  replacementSessionId         String
  replacementGroupId           String
  originalGrade                String
  replacementGrade             String
  validUntil                   DateTime
  status                       MakeupAttendanceStatus @default(RESERVED)
  createdById                  String
  createdAt                    DateTime               @default(now())
  usedAt                       DateTime?
  cancelledAt                  DateTime?
  cancelledById               String?
  cancellationReason           String?
  expiredAt                    DateTime?
  upcomingStatus               UpcomingMakeupStatus?
  upcomingCompletedAt          DateTime?
  upcomingInvalidatedAt        DateTime?
  upcomingInvalidationReason   String?
  center                       Center                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                      Student                @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  originalAttendance           AttendanceRecord?      @relation("MakeupOriginalAttendance", fields: [tenantId, originalAttendanceId], references: [tenantId, id], onDelete: Restrict)
  originalSession              Session                @relation("MakeupOriginalSession", fields: [tenantId, originalSessionId], references: [tenantId, id], onDelete: Restrict)
  originalSchedule             GroupSchedule?         @relation("MakeupOriginalSchedule", fields: [originalScheduleId], references: [id], onDelete: SetNull)
  originalGroup                Group                  @relation("MakeupOriginalGroup", fields: [tenantId, originalGroupId], references: [tenantId, id], onDelete: Restrict)
  replacementSchedule          GroupSchedule?         @relation("MakeupReplacementSchedule", fields: [replacementScheduleId], references: [id], onDelete: SetNull)
  replacementSession           Session                @relation("MakeupReplacementSession", fields: [tenantId, replacementSessionId], references: [tenantId, id], onDelete: Restrict)
  replacementGroup             Group                  @relation("MakeupReplacementGroup", fields: [tenantId, replacementGroupId], references: [tenantId, id], onDelete: Restrict)
  replacementAttendance        AttendanceRecord?      @relation("MakeupReplacementAttendance")
  createdBy                    User                   @relation("MakeupCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  cancelledBy                  User?                  @relation("MakeupCancelledBy", fields: [tenantId, cancelledById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, studentId, status])
  @@index([tenantId, originalAttendanceId, status])
  @@index([tenantId, studentId, type, upcomingStatus])
  @@index([tenantId, replacementSessionId, status])
  @@index([tenantId, status, validUntil])
}

model HomeworkSubmission {
  id                 String                   @id @default(cuid())
  tenantId           String
  attendanceRecordId String                   @unique
  requirementId      String?
  status             HomeworkSubmissionStatus
  note               String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  attendanceRecord   AttendanceRecord         @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requirement        HomeworkRequirement?     @relation(fields: [requirementId], references: [id])
  center             Center                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, requirementId])
  @@index([tenantId, status])
}

model SubscriptionPlan {
  id            String                @id @default(cuid())
  tenantId      String
  name          String
  type          SubscriptionType
  amount        Float
  durationDays  Int
  subscriptions StudentSubscription[]
  center        Center                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
}

model GradeMonthlySubscriptionPrice {
  id        String   @id @default(cuid())
  tenantId  String
  grade     String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  center    Center   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, grade])
  @@index([tenantId])
}

model StudentSubscription {
  id          String           @id @default(cuid())
  tenantId    String
  studentId   String
  planId      String
  startDate   DateTime
  renewalDate DateTime
  discount    Float            @default(0)
  totalAmount Float
  paidAmount  Float            @default(0)
  payments    Payment[]
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  center      Center           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, renewalDate])
  @@index([tenantId, startDate])
  @@index([tenantId, studentId, startDate])
}

model Payment {
  id             String              @id @default(cuid())
  tenantId       String
  studentId      String
  subscriptionId String
  amount         Float
  method         PaymentMethod
  paidAt         DateTime            @default(now())
  receivedBy     String
  receiptNo      String
  receiver       User                @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription   StudentSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  center         Center              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNo])
  @@index([tenantId, paidAt])
  @@index([tenantId, studentId])
}

model ProductCategory {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  center      Center    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model ProductUnit {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  center      Center    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model Supplier {
  id              String          @id @default(cuid())
  tenantId        String
  name            String
  phone           String?
  address         String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  defaultProducts Product[]       @relation("ProductDefaultSupplier")
  purchaseOrders  PurchaseOrder[]
  center          Center          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model Product {
  id                String               @id @default(cuid())
  tenantId          String
  name              String
  sku               String?
  barcode           String?
  description       String?
  categoryId        String
  unitId            String
  defaultSupplierId String?
  openingExpenseId  String?              @unique
  costPrice         Float                @default(0)
  sellingPrice      Float                @default(0)
  minimumStock      Int                  @default(0)
  status            ProductStatus        @default(ACTIVE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  movements         InventoryMovement[]
  stock             InventoryStock?
  category          ProductCategory      @relation(fields: [categoryId], references: [id])
  defaultSupplier   Supplier?            @relation("ProductDefaultSupplier", fields: [defaultSupplierId], references: [id])
  openingExpense    Expense?             @relation("ProductOpeningExpense", fields: [openingExpenseId], references: [id])
  center            Center               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit              ProductUnit          @relation(fields: [unitId], references: [id])
  imageAssets       ProductImageAsset[]
  reservations      ProductReservation[]
  saleItems         ProductSaleItem[]
  purchaseItems     PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, categoryId, status])
  @@index([tenantId, unitId])
  @@index([tenantId, defaultSupplierId])
  @@index([tenantId, name])
}

model ProductImageAsset {
  id           String    @id @default(cuid())
  tenantId     String
  productId    String
  objectKey    String    @unique
  etag         String?
  contentType  String
  sizeBytes    Int
  width        Int
  height       Int
  version      Int       @default(1)
  isCurrent    Boolean   @default(true)
  retiredAt    DateTime?
  uploadedById String?
  createdAt    DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  center       Center    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation("ProductImageAssetUploader", fields: [uploadedById], references: [id])

  @@index([tenantId, createdAt])
  @@index([productId, isCurrent])
  @@index([tenantId, retiredAt])
}

model InventoryStock {
  id        String   @id @default(cuid())
  tenantId  String
  productId String   @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  center    Center   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, onHand])
  @@index([tenantId, reserved])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  orderNumber    String
  supplierId     String
  createdById    String
  expenseId      String?             @unique
  idempotencyKey String
  status         PurchaseOrderStatus @default(RECEIVED)
  purchasedAt    DateTime            @default(now())
  total          Float
  notes          String?
  createdAt      DateTime            @default(now())
  movements      InventoryMovement[]
  createdBy      User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  expense        Expense?            @relation("PurchaseOrderExpense", fields: [expenseId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  center         Center              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, purchasedAt])
  @@index([tenantId, supplierId, purchasedAt])
  @@index([tenantId, createdById, purchasedAt])
}

model PurchaseOrderItem {
  id                  String        @id @default(cuid())
  tenantId            String
  purchaseOrderId     String
  productId           String
  productNameSnapshot String
  skuSnapshot         String?
  quantity            Int
  purchasePrice       Float
  lineTotal           Float
  createdAt           DateTime      @default(now())
  product             Product       @relation(fields: [productId], references: [id])
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, productId])
  @@index([tenantId, productId, createdAt])
}

model ProductSale {
  id                       String                       @id @default(cuid())
  tenantId                 String
  invoiceNumber            String
  type                     ProductSaleType
  studentId                String?
  studentNameSnapshot      String?
  studentCodeSnapshot      String?
  groupNameSnapshot        String?
  soldById                 String
  cancelledById            String?
  idempotencyKey           String
  status                   ProductSaleStatus            @default(COMPLETED)
  paymentStatus            ProductSalePaymentStatus
  chargedToAccount         Boolean                      @default(false)
  subtotal                 Float
  discountTotal            Float                        @default(0)
  total                    Float
  amountPaid               Float                        @default(0)
  amountDue                Float                        @default(0)
  notes                    String?
  soldAt                   DateTime                     @default(now())
  cancelledAt              DateTime?
  cancellationReason       String?
  offlineRefundConfirmedAt DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  movements                InventoryMovement[]
  reservation              ProductReservation?          @relation("ReservationDeliveredSale")
  cancelledBy              User?                        @relation("ProductSaleCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  soldBy                   User                         @relation("ProductSaleSeller", fields: [soldById], references: [id])
  student                  Student?                     @relation(fields: [studentId], references: [id])
  center                   Center                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                    ProductSaleItem[]
  payments                 ProductSalePayment[]
  accountEntries           StudentProductAccountEntry[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, soldAt])
  @@index([tenantId, status, soldAt])
  @@index([tenantId, paymentStatus, soldAt])
  @@index([tenantId, studentId, soldAt])
  @@index([tenantId, soldById, soldAt])
}

model ProductSaleItem {
  id                   String      @id @default(cuid())
  tenantId             String
  saleId               String
  productId            String
  productNameSnapshot  String
  skuSnapshot          String?
  barcodeSnapshot      String?
  categoryNameSnapshot String
  unitNameSnapshot     String
  quantity             Int
  unitPrice            Float
  discount             Float       @default(0)
  lineTotal            Float
  unitCost             Float
  totalCost            Float
  createdAt            DateTime    @default(now())
  product              Product     @relation(fields: [productId], references: [id])
  sale                 ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, productId])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, categoryNameSnapshot, createdAt])
}

model ProductSalePayment {
  id                  String                      @id @default(cuid())
  tenantId            String
  saleId              String
  receiptNumber       String
  idempotencyKey      String
  type                ProductSalePaymentType      @default(COLLECTION)
  amount              Float
  method              PaymentMethod
  receivedById        String
  reversalOfPaymentId String?                     @unique
  note                String?
  paidAt              DateTime                    @default(now())
  createdAt           DateTime                    @default(now())
  receivedBy          User                        @relation("ProductSalePaymentReceiver", fields: [receivedById], references: [id])
  reversalOf          ProductSalePayment?         @relation("ProductSalePaymentReversal", fields: [reversalOfPaymentId], references: [id], onDelete: Restrict)
  reversals           ProductSalePayment?         @relation("ProductSalePaymentReversal")
  sale                ProductSale                 @relation(fields: [saleId], references: [id])
  center              Center                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountEntry        StudentProductAccountEntry?

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId, paidAt])
  @@index([tenantId, type, paidAt])
  @@index([tenantId, receivedById, paidAt])
}

model StudentProductAccount {
  id        String                       @id @default(cuid())
  tenantId  String
  studentId String?                      @unique
  balance   Float                        @default(0)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  student   Student?                     @relation(fields: [studentId], references: [id])
  center    Center                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   StudentProductAccountEntry[]

  @@index([tenantId, balance])
  @@index([tenantId, updatedAt])
}

model StudentProductAccountEntry {
  id           String                         @id @default(cuid())
  tenantId     String
  accountId    String
  studentId    String?
  saleId       String?
  paymentId    String?                        @unique
  type         StudentProductAccountEntryType
  amount       Float
  balanceAfter Float
  description  String?
  actorId      String
  occurredAt   DateTime                       @default(now())
  createdAt    DateTime                       @default(now())
  account      StudentProductAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actor        User                           @relation("StudentProductAccountEntryActor", fields: [actorId], references: [id])
  payment      ProductSalePayment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sale         ProductSale?                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  student      Student?                       @relation(fields: [studentId], references: [id])
  center       Center                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([tenantId, saleId])
  @@index([tenantId, type, occurredAt])
}

model ProductReservation {
  id                  String                   @id @default(cuid())
  tenantId            String
  studentId           String?
  studentNameSnapshot String
  studentCodeSnapshot String
  groupNameSnapshot   String?
  productId           String
  saleId              String?                  @unique
  quantity            Int
  status              ProductReservationStatus @default(PENDING)
  notes               String?
  createdById         String
  deliveredById       String?
  cancelledById       String?
  availableAt         DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  movements           InventoryMovement[]
