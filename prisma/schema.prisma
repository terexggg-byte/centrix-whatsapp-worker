  tenantId  String
  title     String
  body      String
  target    TargetType
  createdAt DateTime   @default(now())
  dedupeKey String?
  metadata  Json?
  readAt    DateTime?
  type      String     @default("MANUAL")
  center    Center     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, readAt, createdAt])
}

model NotificationJob {
  id               String                 @id @default(cuid())
  tenantId         String
  eventType        NotificationEventType
  entityType       String
  entityId         String
  variables        Json
  recipientContext Json
  status           NotificationJobStatus  @default(QUEUED)
  idempotencyKey   String
  errorMessage     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deliveries       NotificationDelivery[]
  center           Center                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, entityType, entityId])
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  tenantId            String
  jobId               String
  eventType           NotificationEventType
  channel             NotificationChannel
  recipientRole       String
  recipientName       String?
  recipientPhone      String?
  recipientAddress    String
  renderedMessage     String
  status              NotificationDeliveryStatus @default(QUEUED)
  scheduledAt         DateTime                   @default(now())
  availableAt         DateTime                   @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  providerMessageId   String?
  errorMessage        String?
  retryCount          Int                        @default(0)
  maxAttempts         Int                        @default(3)
  lockToken           String?
  lockedAt            DateTime?
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  job                 NotificationJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  center              Center                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, availableAt])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, channel, status, availableAt])
  @@index([tenantId, recipientAddress])
  @@index([jobId])
}

model NotificationEventSetting {
  id            String                    @id @default(cuid())
  tenantId      String
  eventType     NotificationEventType
  enabled       Boolean                   @default(true)
  recipientMode NotificationRecipientMode @default(PARENT_FIRST)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  center        Center                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType])
  @@index([tenantId, enabled])
}

model NotificationTemplate {
  id        String                @id @default(cuid())
  tenantId  String
  eventType NotificationEventType
  channel   NotificationChannel
  body      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  center    Center                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, channel])
  @@index([tenantId, channel])
}

model NotificationChannelSetting {
  id                    String              @id @default(cuid())
  tenantId              String
  channel               NotificationChannel
  enabled               Boolean             @default(true)
  minDelaySeconds       Int                 @default(20)
  maxDelaySeconds       Int                 @default(90)
  hourlyLimit           Int                 @default(60)
  dailyLimit            Int                 @default(300)
  retryMaxAttempts      Int                 @default(3)
  retryBaseDelaySeconds Int                 @default(300)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  center                Center              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId, enabled])
}

model WhatsAppSession {
  id              String                   @id @default(cuid())
  tenantId        String                   @unique
  status          WhatsAppConnectionStatus @default(DISCONNECTED)
  phoneNumber     String?
  qrCode          String?
  qrCodeDataUrl   String?
  requestedAt     DateTime?
  lastConnectedAt DateTime?
  disconnectedAt  DateTime?
  errorMessage    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  center          Center                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model WhatsAppAuthState {
  id             String   @id @default(cuid())
  tenantId       String
  key            String
  encryptedValue String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  center         Center   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, updatedAt])
}

model NotificationWorkerLease {
  id          String   @id
  ownerId     String
  ownerLabel  String?
  heartbeatAt DateTime
  expiresAt   DateTime
  capabilities Json?
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@index([ownerId])
}

model AssistantConversation {
  id            String             @id @default(cuid())
  tenantId      String
  userId        String
  title         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lastMessageAt DateTime           @default(now())
  center        Center             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AssistantMessage[]

  @@index([tenantId, userId, lastMessageAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  tenantId       String
  userId         String
  role           AssistantMessageRole
  text           String
  pendingAction  Json?
  suggestions    Json?
  needsInput     Json?
  createdAt      DateTime              @default(now())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  center         Center                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  payload   Json?
  createdAt DateTime @default(now())
  center    Center   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
}

